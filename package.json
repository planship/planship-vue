{
  "name": "@planship/vue",
  "version": "0.3.6",
  "description": "Planship SDK for Vue.js",
  "author": "pawel@planship.io",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && vue-tsc",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(ts|json)\"",
    "publish:alpha": "pnpm build && pnpm publish --tag alpha --no-git-checks",
    "publish:latest": "pnpm build && pnpm publish"
  },
  "dependencies": {
    "@planship/fetch": "0.3.3"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^22.10.10",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "typescript": "~5.4.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
